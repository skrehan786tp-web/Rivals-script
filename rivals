-- 2. CUSTOM BUTTON MAKER (button.png)
local ButtonImageAsset = GetGitHubImage("button.png") -- Aapka button.png yahan load hoga

local function CreateCustomFeature(featureName, callback)
    local Row = Instance.new("Frame")
    Row.Size                   = UDim2.new(1, -10, 0, 36)
    Row.BackgroundColor3       = Color3.fromRGB(20, 10, 35)
    Row.BackgroundTransparency = 0.4
    Row.Parent                 = ContentBox

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent       = Row

    local Label = Instance.new("TextLabel")
    Label.Size                   = UDim2.new(0.6, 0, 1, 0)
    Label.Position               = UDim2.new(0, 12, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text                   = featureName
    Label.TextColor3             = Color3.fromRGB(255, 255, 255)
    Label.Font                   = Enum.Font.GothamSemibold
    Label.TextSize               = 13
    Label.TextXAlignment         = Enum.TextXAlignment.Left
    Label.Parent                 = Row

    -- ImageButton jo aapke button.png ko use karega
    local ImgBtn = Instance.new("ImageButton")
    ImgBtn.Size                   = UDim2.new(0, 100, 0, 28)
    ImgBtn.Position               = UDim2.new(1, -110, 0.5, -14)
    ImgBtn.BackgroundTransparency = 1
    ImgBtn.Image                  = ButtonImageAsset
    ImgBtn.ScaleType              = Enum.ScaleType.Stretch
    ImgBtn.Parent                 = Row

    local StatusTxt = Instance.new("TextLabel")
    StatusTxt.Size                   = UDim2.new(1, 0, 1, 0)
    StatusTxt.BackgroundTransparency = 1
    StatusTxt.Text                   = "" -- Agar button.png par pehle se "Execute" likha hai toh ise khali rakhein
    StatusTxt.TextColor3             = Color3.fromRGB(255, 255, 255)
    StatusTxt.Font                   = Enum.Font.GothamBold
    StatusTxt.TextSize               = 11
    StatusTxt.Parent                 = ImgBtn

    ImgBtn.MouseButton1Click:Connect(function()
        if callback then callback(StatusTxt) end
    end)
end

