-- Yahan apna GitHub username aur repo ka naam dalein
local GITHUB_USER = "skrehan786tp-web"
local GITHUB_REPO = "Rivals-script"
local BRANCH      = "main"

local BaseURL = "https://raw.githubusercontent.com/" .. GITHUB_USER .. "/" .. GITHUB_REPO .. "/" .. BRANCH .. "/"

-- Function jo GitHub se photo download karke Roblox asset banata hai
local function GetGitHubImage(fileName)
    local getAsset = getcustomasset or getsynasset
    if not getAsset then
        warn("Aapka executor custom images support nahi karta!")
        return ""
    end

    if not isfile(fileName) then
        local success, imageData = pcall(function()
            return game:HttpGet(BaseURL .. fileName)
        end)
        if success and imageData then
            writefile(fileName, imageData)
        else
            warn("GitHub se image download nahi ho payi: " .. fileName)
            return ""
        end
    end

    return getAsset(fileName)
end

